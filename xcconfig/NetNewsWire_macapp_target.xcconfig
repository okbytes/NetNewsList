#include "./common/NetNewsWire_codesigning_common.xcconfig"
#include "./common/NetNewsWire_macapp_target_common.xcconfig"

// The work-computer build (NetNewsList_work.xcconfig) swaps in entitlements without iCloud or push.
MAC_APP_ENTITLEMENTS = Mac/Resources/NetNewsWire.entitlements
CODE_SIGN_ENTITLEMENTS = $(MAC_APP_ENTITLEMENTS)
PRODUCT_BUNDLE_IDENTIFIER = $(ORGANIZATION_IDENTIFIER).NetNewsList$(BUNDLE_ID_SUFFIX)
PRODUCT_NAME = $(MAC_APP_NAME)
// The data folder is named after the executable (AppConfig.appName), so both builds keep
// Application Support/NetNewsList.
EXECUTABLE_NAME = NetNewsList
PRODUCT_MODULE_NAME = NetNewsWire

// Read by the app from Info.plist. These builds sync through the CloudKit framework; the
// work-computer build uses CloudKit Web Services instead, and scripts/build-work-mac.sh
// supplies its environment and API token.
NETNEWSLIST_ICLOUD_TRANSPORT = native
NETNEWSLIST_CLOUDKIT_ENVIRONMENT = development
NETNEWSLIST_CLOUDKIT_API_TOKEN =
